rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function orgAllowed(orgId) { return orgId == 'doggystyle'; }
    function email() { return signedIn() ? request.auth.token.get('email', '').lower() : ''; }
    function userPath(orgId) { return /databases/$(database)/documents/orgs/$(orgId)/users/$(request.auth.uid); }
    function profile(orgId) { return get(userPath(orgId)).data; }
    function role(orgId) { return signedIn() && exists(userPath(orgId)) ? profile(orgId).get('role', 'guest') : 'guest'; }
    function owner() { return signedIn() && email() == 'raphael@boch-plan.de' && request.auth.token.get('email_verified', false) == true; }
    function admin(orgId) { return orgAllowed(orgId) && (owner() || role(orgId) == 'admin'); }
    function staff(orgId) { return admin(orgId) || (orgAllowed(orgId) && role(orgId) == 'staff'); }
    function own(data) { return signedIn() && data.get('customerUid', '') == request.auth.uid; }
    function assigned(orgId) {
      return signedIn() && orgAllowed(orgId) && exists(userPath(orgId))
        && profile(orgId).get('accessSchemaVersion', 0) == 3
        && profile(orgId).get('customerId', '') is string && profile(orgId).customerId != ''
        && profile(orgId).get('petIds', []) is list;
    }
    function targetMap(data, cid, pid) {
      return data is map && data.get('customerId', cid) == cid
        && data.get('petId', pid) == pid && data.get('dogId', pid) == pid;
    }
    function payloadTarget(data, cid, pid) {
      let p = data.payloadSubmitted;
      return targetMap(p, cid, pid)
        && targetMap(p.get('meta', {}), cid, pid) && targetMap(p.get('fields', {}), cid, pid)
        && (!p.keys().hasAny(['customer']) || (p.customer is map && p.customer.get('id', '') == cid && p.customer.get('customerId', cid) == cid))
        && (!p.keys().hasAny(['pet']) || (p.pet is map && p.pet.get('id', '') == pid
          && p.pet.get('petId', pid) == pid && p.pet.get('dogId', pid) == pid && p.pet.get('customerId', '') == cid));
    }
    function photoTarget(photo, orgId, pid) {
      return photo is string && (photo == '' || (photo.size() < 180000 && photo.matches('data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+'))
        || (pid != '' && photo.split('/').size() == 5 && photo.split('/')[0] == 'ds-storage:orgs'
          && photo.split('/')[1] == orgId && photo.split('/')[2] == 'pets' && photo.split('/')[3] == pid && photo.split('/')[4] != ''));
    }
    function petPhotos(data, orgId) {
      let pet = data.payloadSubmitted.get('pet', {});
      return photoTarget(pet.get('profilePhoto', ''), orgId, data.petId) && photoTarget(pet.get('vaccinationPassPhoto', ''), orgId, data.petId);
    }
    function contractPayload(data, orgId) {
      let p = data.payloadSubmitted;
      return data.templateId != 'boarding_contract' || (p.get('accepted', false) == true
        && p.get('contractVersion', '') == profile(orgId).portalData.get('contractVersion', '')
        && p.get('signature', {}) is map && p.signature.get('dataUrl', '') is string
        && p.signature.dataUrl.matches('data:image/png;base64,iVBORw0KGgo[A-Za-z0-9+/=]+')
        && p.signature.dataUrl.size() > 128 && p.signature.dataUrl.size() < 180000
        && p.signature.get('signedAt', 0) is number && p.signature.signedAt > 0);
    }
    function stayPayload(data) {
      let p = data.payloadSubmitted;
      let f = p.get('fields', {});
      let m = p.get('meta', {});
      return data.templateId != 'hundeannahme' || (f is map && m is map
        && m.get('von', '') is string && m.von.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && m.get('bis', '') is string && m.bis.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && m.get('betreuung', '') in ['Tagesbetreuung','Urlaubsbetreuung','Probetag']
        && f.get('ev_agb', false) == true && f.get('ev_dsgvo', false) == true && f.get('ev_wahr', false) == true
        && f.get('ev_hv', false) == true && f.get('ev_gesund', false) == true && f.get('ev_tierarzt', false) == true
        && p.get('signature', {}) is map && p.signature.get('dataUrl', '') is string
        && p.signature.dataUrl.matches('data:image/png;base64,iVBORw0KGgo[A-Za-z0-9+/=]+')
        && p.signature.dataUrl.size() > 128 && p.signature.dataUrl.size() < 180000
        && p.signature.get('signedAt', 0) is number && p.signature.signedAt > 0
        && p.get('staySchemaVersion', 0) == 1 && (p.get('consentTexts', {}) is map
          && p.consentTexts.keys().hasAll(['ev_agb','ev_dsgvo','ev_wahr','ev_hv','ev_gesund','ev_tierarzt'])
          && p.consentTexts.ev_agb is string && p.consentTexts.ev_agb.size() > 0
          && p.consentTexts.ev_dsgvo is string && p.consentTexts.ev_dsgvo.size() > 0
          && p.consentTexts.ev_wahr is string && p.consentTexts.ev_wahr.size() > 0
          && p.consentTexts.ev_hv is string && p.consentTexts.ev_hv.size() > 0
          && p.consentTexts.ev_gesund is string && p.consentTexts.ev_gesund.size() > 0
          && p.consentTexts.ev_tierarzt is string && p.consentTexts.ev_tierarzt.size() > 0));
    }
    function sourceTask(data, orgId) {
      let path = /databases/$(database)/documents/orgs/$(orgId)/tasks/$(data.sourceTaskId);
      return data.sourceTaskId == '' || (exists(path) && get(path).data.get('customerUid', '') == request.auth.uid
        && get(path).data.get('customerId', '') == data.customerId && get(path).data.get('templateId', '') == data.templateId
        && get(path).data.get('status', '') == 'open');
    }
    function validSubmission(orgId, docId) {
      let d = request.resource.data;
      return assigned(orgId) && d.keys().hasAll(['id','taskId','proposalId','submissionSchemaVersion','templateId','title','customerUid','customerEmail','customerName','customerId','petId','dogId','sourceTaskId','status','proposalStatus','submittedAt','createdAt','updatedAt','payloadSubmitted'])
        && d.keys().hasOnly(['id','taskId','proposalId','submissionSchemaVersion','templateId','title','customerUid','customerEmail','customerName','customerId','petId','dogId','sourceTaskId','status','proposalStatus','submittedAt','createdAt','updatedAt','payloadSubmitted'])
        && d.id == docId && d.taskId == docId && d.proposalId == docId && d.submissionSchemaVersion == 3
        && d.customerUid == request.auth.uid && d.customerEmail == email() && d.customerId == profile(orgId).customerId
        && d.status == 'submitted' && d.proposalStatus == 'pending'
        && d.templateId in ['customer_data','boarding_contract','hundeannahme']
        && d.petId is string && d.dogId == d.petId && d.sourceTaskId is string
        && (d.petId in profile(orgId).petIds || (d.templateId == 'customer_data' && d.petId == '' && d.payloadSubmitted.get('isNewPet', false) == true))
        && payloadTarget(d, d.customerId, d.petId) && petPhotos(d, orgId) && contractPayload(d, orgId) && stayPayload(d) && sourceTask(d, orgId);
    }
    function counterpart(orgId, collection, docId) {
      return getAfter(/databases/$(database)/documents/orgs/$(orgId)/$(collection)/$(docId)).data == request.resource.data;
    }
    match /orgs/{orgId}/users/{uid} {
      allow read: if orgAllowed(orgId) && signedIn() && (staff(orgId) || request.auth.uid == uid);
      allow create: if admin(orgId) || (orgAllowed(orgId) && signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','displayName','role','createdAt'])
        && request.resource.data.uid == uid && request.resource.data.email == email()
        && request.resource.data.role == 'customer' && request.resource.data.displayName is string);
      allow update: if admin(orgId) || (orgAllowed(orgId) && signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']) && request.resource.data.displayName is string);
      allow delete: if admin(orgId);
      match /notifications/{notificationId} {
        allow read: if orgAllowed(orgId) && signedIn() && (request.auth.uid == uid || staff(orgId));
        allow create: if admin(orgId);
        allow delete: if admin(orgId) || (orgAllowed(orgId) && signedIn() && request.auth.uid == uid && resource.data.get('read', false) == true);
        allow update: if admin(orgId) || (orgAllowed(orgId) && signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read == true);
      }
    }
    match /orgs/{orgId}/inboxArchive/{proposalId} {
      allow read: if staff(orgId);
      allow create: if admin(orgId)
        && request.resource.data.keys().hasOnly(['proposalId','archivedAt','archivedByUid'])
        && request.resource.data.proposalId == proposalId
        && request.resource.data.archivedAt is number && request.resource.data.archivedAt > 0
        && request.resource.data.archivedByUid == request.auth.uid;
      allow update: if false;
      allow delete: if admin(orgId);
    }
    match /orgs/{orgId}/meta/{docId} {
      allow read: if staff(orgId);
      allow create, delete: if admin(orgId);
      allow update: if admin(orgId) || (staff(orgId) && docId == 'workspace_state'
        && request.resource.data.get('secureWorkflowVersion', 0) == resource.data.get('secureWorkflowVersion', 0)
        && request.resource.data.payload.get('contractAgreements', {}) == resource.data.payload.get('contractAgreements', {})
        && request.resource.data.payload.get('contractSignatures', {}) == resource.data.payload.get('contractSignatures', {}));
    }
    match /orgs/{orgId}/tasks/{docId} {
      allow get: if orgAllowed(orgId) && (staff(orgId) || (assigned(orgId) && resource == null) || (signedIn() && own(resource.data)));
      allow list: if orgAllowed(orgId) && (staff(orgId) || (signedIn() && own(resource.data)));
      allow create: if admin(orgId) || (validSubmission(orgId, docId) && counterpart(orgId, 'proposals', docId));
      allow update: if admin(orgId) || (validSubmission(orgId, docId) && request.resource.data == resource.data && counterpart(orgId, 'proposals', docId));
      allow delete: if admin(orgId);
    }
    match /orgs/{orgId}/proposals/{docId} {
      allow get: if orgAllowed(orgId) && (staff(orgId) || (assigned(orgId) && resource == null) || (signedIn() && own(resource.data)));
      allow list: if orgAllowed(orgId) && (staff(orgId) || (signedIn() && own(resource.data)));
      allow create: if admin(orgId) || (validSubmission(orgId, docId) && counterpart(orgId, 'tasks', docId));
      allow update: if admin(orgId) || (validSubmission(orgId, docId) && request.resource.data == resource.data && counterpart(orgId, 'tasks', docId));
      allow delete: if admin(orgId);
    }
    match /orgs/{orgId}/chats/{chatId} {
      function personalClear() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clearedAtByUid','unreadForCustomer','customerLastReadAt','customerLastReadAtMs'])
          && request.resource.data.clearedAtByUid is map
          && request.resource.data.clearedAtByUid.diff(resource.data.get('clearedAtByUid', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.clearedAtByUid[request.auth.uid] is number;
      }
      allow get: if orgAllowed(orgId) && (staff(orgId) || (signedIn() && resource != null && own(resource.data))
        || (assigned(orgId) && resource == null && chatId in [request.auth.uid + '__raphael', request.auth.uid + '__anschi']));
      allow list: if orgAllowed(orgId) && (staff(orgId) || (signedIn() && own(resource.data)));
      allow create: if staff(orgId) || (assigned(orgId) && own(request.resource.data)
        && request.resource.data.get('customerEmail', '') == email() && request.resource.data.get('customerId', '') == profile(orgId).customerId);
      allow update: if staff(orgId) || (assigned(orgId) && own(resource.data) && (personalClear()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','updatedAtMs','lastMessageAt','lastMessageAtMs','lastMessageText','lastMessageFromRole','unreadForStaff','unreadForCustomer','customerLastReadAt','customerLastReadAtMs','teamMemberKey','teamMemberLabel','status'])));
      allow delete: if admin(orgId);
      match /messages/{messageId} {
        function chatOwner() { return own(get(/databases/$(database)/documents/orgs/$(orgId)/chats/$(chatId)).data); }
        function hideOwnDecision() {
          return resource.data.get('kind', '') == 'decision' && resource.data.get('customerUid', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenForUids'])
            && request.resource.data.hiddenForUids is map
            && request.resource.data.hiddenForUids.diff(resource.data.get('hiddenForUids', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.hiddenForUids[request.auth.uid] == true;
        }
        allow read: if orgAllowed(orgId) && (staff(orgId) || (signedIn() && chatOwner()));
        allow create: if staff(orgId) || (assigned(orgId) && chatOwner() && request.resource.data.get('senderUid', '') == request.auth.uid
          && request.resource.data.get('senderRole', '') == 'customer' && request.resource.data.get('customerUid', '') == request.auth.uid);
        allow update: if staff(orgId) || (assigned(orgId) && chatOwner() && (hideOwnDecision()
          || (resource.data.get('senderUid', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt','deleted','deletedAt','attachments']))));
        allow delete: if staff(orgId) || (assigned(orgId) && chatOwner() && resource.data.get('senderUid', '') == request.auth.uid);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
