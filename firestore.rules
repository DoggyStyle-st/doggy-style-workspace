rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function userDoc(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/users/$(request.auth.uid));
    }

    function role(orgId) {
      return signedIn() && userDoc(orgId).data != null && userDoc(orgId).data.role != null
        ? userDoc(orgId).data.role
        : 'guest';
    }

    function isAdmin(orgId) { return role(orgId) == 'admin'; }
    function isStaff(orgId) { return role(orgId) == 'admin' || role(orgId) == 'staff'; }
    function sameEmail(email) {
      return signedIn()
        && request.auth.token.email != null
        && email != null
        && request.auth.token.email == email;
    }
    function isChatOwner(data) {
      return signedIn()
        && data != null
        && (
          (data.customerUid != null && data.customerUid == request.auth.uid) ||
          (data.customerEmail != null && sameEmail(data.customerEmail))
        );
    }

    match /orgs/{orgId}/users/{uid} {
      allow read: if signedIn() && (isStaff(orgId) || request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if signedIn() && (isAdmin(orgId) || request.auth.uid == uid);
    }

    match /orgs/{orgId}/meta/{docId} {
      allow read, write: if signedIn() && isStaff(orgId);
    }

    match /orgs/{orgId}/tasks/{taskId} {
      allow create, update, delete: if signedIn() && isStaff(orgId);
      allow read: if signedIn() && (isStaff(orgId) || (resource.data.customerUid == request.auth.uid));
    }

    match /orgs/{orgId}/chats/{chatId} {
      allow read: if signedIn() && (isStaff(orgId) || isChatOwner(resource.data));
      allow create: if signedIn() && (isStaff(orgId) || isChatOwner(request.resource.data));
      allow update: if signedIn() && (isStaff(orgId) || isChatOwner(resource.data) || isChatOwner(request.resource.data));
      allow delete: if signedIn() && isStaff(orgId);

      match /messages/{messageId} {
        allow read: if signedIn() && (
          isStaff(orgId)
          || isChatOwner(get(/databases/$(database)/documents/orgs/$(orgId)/chats/$(chatId)).data)
        );
        allow create: if signedIn() && (
          isStaff(orgId)
          || isChatOwner(get(/databases/$(database)/documents/orgs/$(orgId)/chats/$(chatId)).data)
        );
        allow update, delete: if signedIn() && isStaff(orgId);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
