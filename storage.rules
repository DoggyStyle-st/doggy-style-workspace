rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function email() { return signedIn() && request.auth.token.email != null ? request.auth.token.email : ''; }
    function isRaphael() { return signedIn() && email() == 'raphael@boch-plan.de'; }
    function isStaffOrg(orgId) {
      return signedIn() && (
        isRaphael() ||
        firestore.get(/databases/(default)/documents/orgs/$(orgId)/users/$(request.auth.uid)).data.role in ['admin','staff']
      );
    }
    function chatDoc(orgId, chatId) {
      return firestore.get(/databases/(default)/documents/orgs/$(orgId)/chats/$(chatId)).data;
    }
    function isChatOwner(orgId, chatId) {
      return signedIn() && chatDoc(orgId, chatId) != null && (
        (chatDoc(orgId, chatId).customerUid != null && chatDoc(orgId, chatId).customerUid == request.auth.uid) ||
        (chatDoc(orgId, chatId).customerEmail != null && chatDoc(orgId, chatId).customerEmail == email())
      );
    }

    match /orgs/{orgId}/chatMedia/{chatId}/{fileName} {
      allow read: if signedIn() && (isStaffOrg(orgId) || isChatOwner(orgId, chatId));
      allow create: if signedIn() && (isStaffOrg(orgId) || isChatOwner(orgId, chatId));
      allow delete: if signedIn() && (isStaffOrg(orgId) || isChatOwner(orgId, chatId));
      allow update: if false;
    }
  }
}
